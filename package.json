{
  "name": "knowbase-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --workspace backend",
    "build": "tsc -b && vite build",
    "build:api": "npm run build --workspace backend",
    "vercel-build": "npm run build:api && npm run build",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed-global": "npm run db:seed-global --workspace backend",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@uiw/react-codemirror": "^4.25.10",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.6",
    "js-yaml": "^5.2.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
