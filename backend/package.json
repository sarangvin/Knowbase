{
  "name": "knowbase-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -b && npm run bundle",
    "bundle": "esbuild src/app.ts --bundle --platform=node --format=esm --target=node22 --external:pg-native --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --outfile=dist/app.bundle.js --log-level=warning && echo \"export * from './app.js'\" > dist/app.bundle.d.ts",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed-global": "tsx --env-file=.env src/db/seedGlobalVault.ts",
    "db:migrate:ci": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "razorpay": "^2.9.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
